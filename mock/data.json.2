,\"region\":\"US\",\"agg_level\":3,\"item_id\":0,\"shop_id\":0,\"cspu_id\":\"100000001821795\",\"model_id\":0,\"hero_media\":{\"product_image_id\":[\"https://cf.shopee.sg/file/sg-11134327-823q6-motq7gcyxyps86\"]},\"summary\":{\"brand\":\"TGDLLF\",\"title\":\"WiFi Extender, WiFi Extenders Signal Booster for Home Up to 5000 sq.ft and 50 Devices, WiFi Range Extender, Wireless Repeater, Long Range Amplifier with Ethernet Port, 1-Tap Setup, Alexa Compatible\",\"price\":{\"single_value\":1087000,\"range_min\":0,\"range_max\":0,\"currency\":\"USD\"}},\"variation_infos\":null,\"model_infos\":{\"models\":[{\"cspu_id\":\"100000001821795\",\"extinfo\":{}}],\"cur_model_idx\":0},\"review_data\":{\"summary\":{\"total_count\":1,\"summary_text\":\"Customer feedback is mixed. While some users praise the easy setup and extended coverage, allowing them to connect their Wi-Fi from their yard, others find the configuration confusing and report defective units where the push button fails to work.\"},\"featured_reviews\":[{\"comment_id\":329757353,\"user_name\":\"Ashley\",\"rating\":4,\"content\":\"We have struggled with extending the WiFi but this little guy sure did help. No more internet gaps.\",\"source\":\"brightdata\",\"create_time\":1790035200},{\"comment_id\":317515219,\"user_name\":\"anonymous\",\"rating\":5,\"content\":\"works great easy connection with no problem\",\"source\":\"brightdata\",\"sort_order\":1,\"create_time\":1788652800},{\"comment_id\":314945159,\"user_name\":\"Mintrous\",\"rating\":1,\"content\":\"damage push button not working. doing a return\",\"source\":\"crawler\",\"sort_order\":2,\"create_time\":1788566400},{\"comment_id\":279787737,\"user_name\":\"Margaret\",\"rating\":1,\"content\":\"doe s not work for standard electric.\",\"source\":\"brightdata\",\"sort_order\":3,\"create_time\":1786579200},{\"comment_id\":264864328,\"user_name\":\"Lucinda\",\"rating\":1,\"content\":\"no cord in the box and the box has been opened.\",\"source\":\"brightdata\",\"sort_ord