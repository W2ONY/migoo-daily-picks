owser.downloads.location.description\": \"System Downloads folder\",\n  \"web.browser.downloads.location.title\": \"Location\",\n  \"web.browser.general\": \"General\",\n  \"web.browser.import\": \"Import\",\n  \"web.browser.local.url.destination.description\": \"Where local development sites open by default\",\n  \"web.browser.local.url.destination.title\": \"Local URL open destination\",\n  \"web.browser.manage\": \"Manage\",\n  \"web.browser.password.manager.description\": \"Add, delete, and edit saved passwords\",\n  \"web.browser.password.manager.title\": \"Password manager\",\n  \"web.browser.password.tab.advanced\": \"Advanced\",\n  \"web.browser.password.tab.passwords\": \"Passwords\",\n  \"web.browser.permissions\": \"Permissions\",\n  \"web.browser.site.settings.description\": \"Control camera and microphone permissions in the built-in browser\",\n  \"web.browser.site.settings.title\": \"Site settings\",\n  \"web.browser.web.url.destination.description\": \"Where links open by default\",\n  \"web.browser.web.url.destination.title\": \"Web URL and link open destination\",\n  \"web.permissions.allowed\": \"Allowed\",\n  \"web.permissions.location\": \"Location\",\n  \"web.permissions.location.off\": \"Location access is turned off. Tap the site settings icon in your address bar to adjust it.\",\n  \"web.permissions.location.on\": \"Location access is turned on. Tap the site settings icon in your address bar to adjust it.\",\n  \"web.permissions.microphone\": \"Microphone\",\n  \"web.permissions.microphone.off\": \"Microphone access is turned off. Tap the site settings icon in your address bar to adjust it.\",\n  \"web.permissions.microphone.on\": \"Microphone access is turned on. Tap the site settings icon in your address bar to adjust it.\",\n  \"web.permissions.not.allowed\": \"Not Allowed\",\n  \"web.permissions.notification\": \"Notifications\",\n  \"web.permissions.notification.allowed\": \"Allowed\",\n  \"web.permissions.notification.hint.denied\": \"Notifications are blocked. Please enable them in your browser settings.\",\n  \"web.permissions.notification.hint.subscribed\": \"Notifications enabled\",\n  \"web.permissions.notification.hint.unsubscribed\": \"Notifications turned off.\",\n  \"web.permissions.notification.hint.unsupported\": \"Your browser does not support web notifications.\",\n  \"web.permissions.notification.notAllowed\": \"Not Allowed\",\n  \"web.permissions.notification.on\": \"Notifications are already enabled\",\n  \"web.permissions.notification.unsupported\": \"Unsupported\",\n  \"web.permissions.title\": \"Web Permissions\",\n  \"welcome.agreement_notice\": \"By continuing, you agree to Migoo's {termsLink} and {privacyLink}\",\n  \"welcome.card_1_alt\": \"Migoo proactive AI agent auto-manages email and calendar by processing unread emails, morning briefings, and urgent notifications.\",\n  \"welcome.card_2_alt\": \"Migoo proactive AI agent auto-manages projects and meetings by preparing discussion points, progress reports, and presentation decks.\",\n  \"welcome.card_3_alt\": \"Migoo proactive AI agent supports job hunting by improving LinkedIn profiles, optimizing CVs, and tracking job applications.\",\n  \"welcome.connecting\": \"Connecting...\",\n  \"welcome.continue_google\": \"Continue with Google\",\n  \"welcome.continue_shopee\": \"Continue with Shopee\",\n  \"welcome.download_app\": \"Download App\",\n  \"welcome.download_subtitle\": \"Your personal intelligence, now on every device\",\n  \"welcome.download_title\": \"Download\",\n  \"welcome.feature_1_bullet_1\": \"Briefings that know the \\\"why.\\\"\",\n  \"welcome.feature_1_bullet_2\": \"Auto-adapts to your rhythm.\",\n  \"welcome.feature_1_title\": \"Anticipates Your Day.\\nPerfects Your Flow.\",\n  \"welcome.feature_2_bullet_1\": \"Memory that grows with you.\",\n  \"welcome.feature_2_bullet_2\": \"Instant recall of your preferences.\",\n  \"welcome.feature_2_title\": \"Remembers Your Life.\\nUnderstands Your Style.\",\n  \"welcome.feature_3_bullet_1\": \"Set-and-forget monitoring.\",\n  \"welcome.feature_3_bullet_2\": \"Instant alerts on what matters.\",\n  \"welcome.feature_3_title\": \"Works In Silence.\\nActs On Cue.\",\n  \"welcome.footer.company.us\": \"Marvelous Technology Inc.\",\n  \"welcome.footer.join.community\": \"Join Community\",\n  \"welcome.footer_company\": \"InfiniteAI Private Limited\",\n  \"welcome.footer_contact\": \"Contact Us\",\n  \"welcome.footer_copyright\": \"©2026 Migoo\",\n  \"welcome.footer_privacy\": \"Privacy Policy\",\n  \"welcome.footer_slack\": \"Slack\",\n  \"welcome.footer_terms\": \"Terms of Service\",\n  \"welcome.google_data_notice\": \"Your Google information may be used to organize your email and calendar and better understand your preferences. By continuing, you agree to the {termsLink}; {dataLink}\",\n  \"welcome.hero_subtitle\": \"Built for you, work for you\",\n  \"welcome.hero_subtitle_desktop\": \"Most Al waits. Migoo moves. Working in the background so you can focus on what matters.\",\n  \"welcome.hero_subtitle_mobile\": \"Most AI waits. Migoo moves. Give it a task and it works in the background — across email, calendar, meetings, and the job hunt. It does the groundwork; you make the call.\",\n  \"welcome.hero_subtitle_web\": \"Most AI waits. Migoo moves. Give it an auto task and it works quietly in the background — across email, calendar, meetings, projects, and the job hunt — drafting your replies, prepping your meetings, writing your reports, sharpening your CV. It does the groundwork; you make the call. Proactive by design, approved by you.\",\n  \"welcome.hero_title\": \"Personalized AI for you\",\n  \"welcome.hero_title_v2\": \"Auto Your Tasks for Work and Life.\",\n  \"welcome.home.agent.banner.title\": \"Your AI team, ready to work right away\",\n  \"welcome.home.agent.experts.add\": \"Add\",\n  \"welcome.home.agent.experts.cards.agent_1\": \"Slide Assistant\",\n  \"welcome.home.agent.experts.cards.agent_1.desc\": \"Turns your ideas and notes into polished, presentation-ready slide decks.\",\n  \"welcome.home.agent.experts.cards.agent_1.tags_1\": \"Deck Creation\",\n  \"welcome.home.agent.experts.cards.agent_1.tags_2\": \"Presentation Design\",\n  \"welcome.home.agent.experts.cards.agent_1.tags_3\": \"Data Storytelling\",\n  \"welcome.home.agent.experts.cards.agent_2\": \"Video Ad Producer\",\n  \"welcome.home.agent.experts.cards.agent_2.desc\": \"Creates scroll-stopping video ads designed to drive action and conversion.\",\n  \"welcome.home.agent.experts.cards.agent_2.tags_1\": \"Ad Video Creation\",\n  \"welcome.home.agent.experts.cards.agent_2.tags_2\": \"Product Storytelling\",\n  \"welcome.home.agent.experts.cards.agent_3\": \"Creative Designer\",\n  \"welcome.home.agent.experts.cards.agent_3.desc\": \"Turns your ideas into standout logos, campaign visuals, product imagery, and illustrations.\",\n  \"welcome.home.agent.experts.cards.agent_3.tags_1\": \"Brand Design\",\n  \"welcome.home.agent.experts.cards.agent_3.tags_2\": \"Marketing Creative\",\n  \"welcome.home.agent.experts.cards.agent_3.tags_3\": \"Product Visuals\",\n  \"welcome.home.agent.experts.cards.agent_4\": \"Data Analysis Assistant\",\n  \"welcome.home.agent.experts.cards.agent_4.desc\": \"Turns spreadsheets and tabular data into clear, decision-ready insights — trends, anomalies, and reports you can act on, on demand or on a schedule.\",\n  \"welcome.home.agent.experts.cards.agent_4.tags_1\": \"Data Exploration\",\n  \"welcome.home.agent.experts.cards.agent_4.tags_2\": \"Trend Analysis\",\n  \"welcome.home.agent.experts.cards.agent_4.tags_3\": \"Insight Reporting\",\n  \"welcome.home.agent.experts.cards.brochure_creator\": \"Brochure Creator\",\n  \"welcome.home.agent.experts.cards.desc_1\": \"Designs polished brochures from your content, images, and brand materials.\",\n  \"welcome.home.agent.experts.cards.desc_2\": \"Creates campaign-ready video ads from briefs, product assets, and brand materials.\",\n  \"welcome.home.agent.experts.cards.tags.content_formatting\": \"Content Formatting\",\n  \"welcome.home.agent.experts.cards.tags.spreadsheet_insights\": \"Spreadsheet Insights\",\n  \"welcome.home.agent.experts.cards.video_ad_producer\": \"Video Ad Producer\",\n  \"welcome.home.agent.experts.footer\": \"See all experts\",\n  \"welcome.home.agent.experts.title\": \"Or start with an expert\",\n  \"welcome.home.agent.main_card.cta\": \"Create Agent\",\n  \"welcome.home.agent.main_card.desc\": \"Describe it in a sentence. Chat with it in seconds.\",\n  \"welcome.home.agent.main_card.title\": \"Bulid your own AI teammate\",\n  \"welcome.home.agreement_notice\": \"By continuing, you agree to Migoo's {termsLink} and {privacyLink}\",\n  \"welcome.home.ai_team\": \"AI Team\",\n  \"welcome.home.assistant.card.connect\": \"Connect\",\n  \"welcome.home.assistant.card.connect_google\": \"Connect Google\",\n  \"welcome.home.assistant.card.tools\": \"Inbox • Calendar • Files\",\n  \"welcome.home.assistant.chip.auto_task\": \"Auto-task\",\n  \"welcome.home.assistant.chip.mails\": \"Mails\",\n  \"welcome.home.assistant.chip.more\": \"More\",\n  \"welcome.home.assistant.chip.others\": \"Others\",\n  \"welcome.home.assistant.chip.schedule\": \"Schedule\",\n  \"welcome.home.assistant.chip.shopping\": \"Shopping\",\n  \"welcome.home.assistant.chip.writing\": \"Writing\",\n  \"welcome.home.assistant.greet_1\": \"Hi, I'm Migoo👋 Nice to meet you.\",\n  \"welcome.home.assistant.greet_2\": \"I get real work done - drafting reports, filing expenses, building decks, clearing inboxes.\",\n  \"welcome.home.assistant.greet_3\": \"Hand me something and I'll take it from there.\",\n  \"welcome.home.assistant.work_1\": \"Draft my weekly report from Slack\",\n  \"welcome.home.assistant.work_2\": \"File this month's expenses\",\n  \"welcome.home.assistant.work_3\": \"Outline a deck for Monday's review\",\n  \"welcome.home.auto_task.agent_name.finance_buddy\": \"Finance Buddy\",\n  \"welcome.home.auto_task.agent_name.main\": \"Migoo Main Agent\",\n  \"welcome.home.auto_task.agent_name.slide_agent\": \"Slide Agent\",\n  \"welcome.home.auto_task.agent_name.study_manager\": \"Study Manager\",\n  \"welcome.home.auto_task.header.title\": \"Auto-task\",\n  \"welcome.home.auto_task.task.cta.adjust\": \"Adjust with Migoo\",\n  \"welcome.home.auto_task.task.desc.auto_review_meeting_materials\": \"Runs automatically before meetings that include pre-read materials, summarizing the attached materials and showing key points, suggested questions and possible responses.\",\n  \"welcome.home.auto_task.task.desc.critical_email_alert\": \"Receive an alert whenever an important email arrives. You can customize which senders or contacts are…\",\n  \"welcome.home.auto_task.task.desc.default\": \"When my manager sends me an email, immediately alert me with a brief summary of the content and any action items.\",\n  \"welcome.home.auto_task.task.desc.evening_recap\": \"Wraps up your day by flagging emails that still need attention and previewing what you need to prepare for tomorrow.\",\n  \"welcome.home.auto_task.task.desc.manager_meeting_prep\": \"Runs automatically before meetings with your manager, using past context and recent work progress to help you prepare. You can adjust who counts as your manager in the trigger conditions.\",\n  \"welcome.home.auto_task.task.desc.morning_briefing\": \"Every morning, receive a personalized briefing summarizing your critical emails, key meetings, and important news to help you prepare for the day ahead.\",\n  \"welcome.home.auto_task.task.desc.new_attendee_briefing\": \"Runs automatically one hour before each meeting to brief you on attendees you may not know, so you can join prepared.\",\n  \"welcome.home.auto_task.task.desc.process_unread_email\": \"At 9:00 AM and 5:00 PM each day, triage your unread emails based on your email habits: drafts replies, highlights messages that need your attention, and marks the rest as read.\",\n  \"welcome.home.auto_task.task.desc.weekly_work_progress_summary\": \"At 3:00 PM every Friday, turns your work updates and project context into a weekly progress report, helping you recap and plan ahead.\",\n  \"welcome.home.auto_task.task.notify.app\": \"Notify via: Migoo App\",\n  \"welcome.home.auto_task.task.notify.full\": \"Notify via: Migoo App/Web\",\n  \"welcome.home.auto_task.task.title.auto_review_meeting_materials\": \"Auto Review Meeting Materials\",\n  \"welcome.home.auto_task.task.title.boss_email_alert\": \"Boss Email Alert\",\n  \"welcome.home.auto_task.task.title.critical_email_alert\": \"Critical Email Alert\",\n  \"welcome.home.auto_task.task.title.evening_recap\": \"Evening Recap\",\n  \"welcome.home.auto_task.task.title.manager_meeting_prep\": \"Prepare for Meetings with Your Manager\",\n  \"welcome.home.auto_task.task.title.morning_briefing\": \"Morning Briefing\",\n  \"welcome.home.auto_task.task.title.new_attendee_briefing\": \"New Meeting Attendee Briefing\",\n  \"welcome.home.auto_task.task.title.process_unread_email\": \"Process Unread Email\",\n  \"welcome.home.auto_task.task.title.project_deadline_watch\": \"Project Deadline Watch\",\n  \"welcome.home.auto_task.task.title.weekly_report_drafting\": \"Weekly Report Drafting\",\n  \"welcome.home.auto_task.task.title.weekly_work_progress_summary\": \"Weekly Work Progress Summary\",\n  \"welcome.home.btn.download_desktop_app\": \"Download Desktop App\",\n  \"welcome.home.btn.download_migoo\": \"Download Migoo\",\n  \"welcome.home.btn.try_migoo\": \"Try Migoo for Free\",\n  \"welcome.home.chat.disclaimer\": \"Migoo is AI and can make mistakes. Please double-check the responses.\",\n  \"welcome.home.footer_terms\": \"A team of expert AI agents, grounded in your context and ready to take on research, content, design, presentations, data, and more.\",\n  \"welcome.home.migoo_your_team\": \"Migoo, Your {aiTeam}\",\n  \"welcome.home.new_task.chip.course_work\": \"Coursework\",\n  \"welcome.home.new_task.chip.data_analysis\"