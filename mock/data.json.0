ance\": \"Stocks, ETFs and quotes, technical indicators, fundamentals, corporate filings and insider activity...\",\n  \"welcome.home.skill.desc.legal_contract_review\": \"Review contracts against your organization's negotiation playbook, flagging deviations\",\n  \"welcome.home.skill.title.ai_youtuber_followers\": \"ai-youtuber-followers\",\n  \"welcome.home.skill.title.create_skill\": \"create-skill\",\n  \"welcome.home.skill.title.cx_ticket_triage\": \"cx-ticket-triage\",\n  \"welcome.home.skill.title.data_analysis\": \"data-analysis\",\n  \"welcome.home.skill.title.data_exploration\": \"data-exploration\",\n  \"welcome.home.skill.title.deep_research\": \"deep-research\",\n  \"welcome.home.skill.title.events_discovery\": \"events-discovery\",\n  \"welcome.home.skill.title.finance\": \"finance\",\n  \"welcome.home.skill.title.flight_search\": \"flight-search\",\n  \"welcome.home.skill.title.legal_contract_review\": \"legal-contract-review\",\n  \"welcome.home.skills.category_tabs.business\": \"Business\",\n  \"welcome.home.skills.category_tabs.creative\": \"Creative\",\n  \"welcome.home.skills.category_tabs.education\": \"Education\",\n  \"welcome.home.skills.category_tabs.finance\": \"Finance\",\n  \"welcome.home.skills.category_tabs.life\": \"Life\",\n  \"welcome.home.skills.category_tabs.my_skills\": \"My Skills\",\n  \"welcome.home.skills.category_tabs.productivity\": \"Productivity\",\n  \"welcome.home.skills.category_tabs.recommend\": \"Recommend\",\n  \"welcome.home.skills.category_tabs.research\": \"Research\",\n  \"welcome.home.skills.filter_tabs.added_by_me\": \"Added by Me\",\n  \"welcome.home.skills.filter_tabs.all\": \"All\",\n  \"welcome.home.skills.filter_tabs.built_in\": \"Built-in\",\n  \"welcome.home.skills.filter_tabs.created_by_me\": \"Created by Me\",\n  \"welcome.home.skills.header.connectors_title\": \"Connectors\",\n  \"welcome.home.skills.header.create_button\": \"Create\",\n  \"welcome.home.skills.header.search_placeholder\": \"Search skills name or description\",\n  \"welcome.home.skills.header.skills_title\": \"Skills\",\n  \"welcome.home.title\": \"Ready to Work Right Away\",\n  \"welcome.learn_data_usage\": \"Learn more about how your data is used\",\n  \"welcome.log_in\": \"Log in\",\n  \"welcome.login_failed_content\": \"An error occurred during login\",\n  \"welcome.login_failed_title\": \"Login Failed\",\n  \"welcome.plans.basic\": \"Basic\",\n  \"welcome.plans.basic.subtitle\": \"For getting started\",\n  \"welcome.plans.cta.free_trial\": \"Start 3-Day Free Trial\",\n  \"welcome.plans.cta.save_percent\": \"{percent} Off\",\n  \"welcome.plans.current_plan\": \"Current Plan\",\n  \"welcome.plans.free\": \"Free\",\n  \"welcome.plans.free.points\": \"{points} points free to start\",\n  \"welcome.plans.free.subtitle\": \"Try Migoo for free\",\n  \"welcome.plans.free.upgrade_tip\": \"Upgrade plan for more credits\",\n  \"welcome.plans.max\": \"Max\",\n  \"welcome.plans.max.subtitle\": \"For power users\",\n  \"welcome.plans.monthly\": \"Monthly\",\n  \"welcome.plans.per_month\": \"/ month\",\n  \"welcome.plans.plus\": \"Plus\",\n  \"welcome.plans.plus.subtitle\": \"For everyday work\",\n  \"welcome.plans.points_per_day\": \"points / day\",\n  \"welcome.plans.points_per_month\": \"points / month\",\n  \"welcome.plans.pro\": \"Pro\",\n  \"welcome.plans.pro.subtitle\": \"For heavy daily use\",\n  \"welcome.plans.recommend_tip\": \"Most Popular\",\n  \"welcome.plans.subtitle\": \"Flexible plans for every workload, from everyday tasks to ambitious projects.\",\n  \"welcome.plans.title\": \"Choose Your Plan\",\n  \"welcome.plans.yearly\": \"Yearly\",\n  \"welcome.scopes_modal_desc\": \"Allow following Google access so Migoo can work its magic\",\n  \"welcome.scopes_modal_title\": \"Just one more step\",\n  \"welcome.seo.description\": \"Migoo is a team of expert AI agents, grounded in your context, ready to take on research, content, design, presentations, data, and more.\",\n  \"welcome.seo.title\": \"Migoo - Your AI Team, Ready to Work Right Away\",\n  \"welcome.terms_of_service\": \"Terms of Service\",\n  \"welcome.text_screen_tagline\": \"See what Migoo can do when it truly understands your life.\",\n  \"welcome.tos_toast\": \"Please agree to the Terms of Service to continue\",\n  \"welcome.try_imessage\": \"Try in iMessage\",\n  \"welcome.use_case_title\": \"See How Migoo Works Ahead of You — Across Work and Life.\",\n  \"welcome.usecase_1_alt\": \"Migoo morning briefing card summarizing weather, unread emails, urgent notifications, and meetings for the day.\",\n  \"welcome.usecase_1_desc\": \"Migoo brings together your emails, follow-ups, and meetings that matter most today, all in one place.\",\n  \"welcome.usecase_1_title\": \"Morning Briefing of Your Day\",\n  \"welcome.usecase_2_alt\": \"Migoo inbox processing card showing 15 unread emails, drafted replies, urgent emails, and important client follow-ups.\",\n  \"welcome.usecase_2_desc\": \"Migoo drafts replies, flags what's important, and summarizes the rest, the way you'd handle it yourself.\",\n  \"welcome.usecase_2_title\": \"Process Unread & Urgent Email\",\n  \"welcome.usecase_3_alt\": \"Migoo weekly report card showing project progress, revenue update, charts, and blockers that need attention.\",\n  \"welcome.usecase_3_desc\": \"Migoo turns your work into a clear report of what's done, what's pending, blockers, and next steps.\",\n  \"welcome.usecase_3_title\": \"Periodic Work Progress Update\",\n  \"welcome.usecase_4_alt\": \"Migoo meeting brief card organizing company background, discussion points, and meeting angles from attachments.\",\n  \"welcome.usecase_4_desc\": \"Migoo reviews your materials in advance and hands you the key points, context, and questions to raise, so you walk in ready.\",\n  \"welcome.usecase_4_title\": \"Get Key Discussion Points from Meeting Attachments\",\n  \"welcome.usecase_5_alt\": \"Migoo LinkedIn profile card showing an updated role, polished profile content, and career profile improvements.\",\n  \"welcome.usecase_5_desc\": \"Migoo keeps your profile polished, drafts posts, and sends connection requests — with your approval before anything goes out.\",\n  \"welcome.usecase_5_title\": \"Linkedin Profile Tracking and Improvements\",\n  \"welcome.usecase_6_alt\": \"Migoo CV optimization card showing a tailored CV, job matching, and an improved application score.\",\n  \"welcome.usecase_6_desc\": \"Migoo tailors your CV to each job, by highlighting your most relevant experience, skills, and keywords.\",\n  \"welcome.usecase_6_title\": \"CV Optimization for Different Job Posts\",\n  \"welcome.v2.agents.ai.photo.editor.chat.greeting\": \"Hi, I’m AI Photo Editor. I can retouch a portrait, try a new look, swap the background, or reimagine your photo in a whole new style. Send me a photo and tell me what you’re imagining—I’ll help you bring it to life.\",\n  \"welcome.v2.agents.ai.photo.editor.chat.input.image.alt\": \"Portrait photo provided for editing\",\n  \"welcome.v2.agents.ai.photo.editor.chat.prompt\": \"Turn this photo into a realistic American high school yearbook portrait.\",\n  \"welcome.v2.agents.ai.photo.editor.chat.response\": \"I created three American high school yearbook portraits. Choose your favorite, or ask me to adjust the outfit, backdrop, or pose.\",\n  \"welcome.v2.agents.ai.photo.editor.chat.result.image.alt\": \"AI-generated American high school yearbook portrait\",\n  \"welcome.v2.agents.ai.photo.editor.description\": \"Retouch, transform, and reimagine photos in any style.\",\n  \"welcome.v2.agents.ai.photo.editor.name\": \"AI Photo Editor\",\n  \"welcome.v2.agents.brochure.creator.chat.artifact.meta\": \"PDF · 2.6MB · 6 pages\",\n  \"welcome.v2.agents.brochure.creator.chat.artifact.title\": \"SORA NUSA ECO RETREAT\",\n  \"welcome.v2.agents.brochure.creator.chat.greeting\": \"Hi! I'm Brochure Creator. Share your brand, product, service, event, or portfolio materials, and I'll turn them into a professional brochure with a well-structured layout, persuasive copy, and polished visual design.\",\n  \"welcome.v2.agents.brochure.creator.chat.input.image.alt\": \"Sora Nusa Eco Retreat photos and brand notes\",\n  \"welcome.v2.agents.brochure.creator.chat.prompt\": \"Create a polished six-page digital brochure for Sora Nusa Eco Retreat using the attached photos and brand notes.\",\n  \"welcome.v2.agents.brochure.creator.chat.response\": \"Your six-page Sora Nusa Eco Retreat brochure is ready. It uses all five supplied photos to present the retreat story, villas, dining, local experiences, and opening offer in a natural cream, deep-green, and terracotta design.\",\n  \"welcome.v2.agents.brochure.creator.chat.result.image.alt\": \"Sora Nusa Eco Retreat brochure preview\",\n  \"welcome.v2.agents.brochure.creator.description\": \"Turn your content into designed brochures.\",\n  \"welcome.v2.agents.brochure.creator.name\": \"Brochure Creator\",\n  \"welcome.v2.agents.creative.designer.chat.greeting\": \"Hi, I’m Creative Designer. I can turn a rough idea into a polished logo, ad, social post, product visual, or illustration. Tell me what you’d like to make—and if you have any copy, images, or references, just drop them in.\",\n  \"welcome.v2.agents.creative.designer.chat.prompt\": \"Create a logo and Instagram posters for EVERA, a refillable body-wash brand.\",\n  \"welcome.v2.agents.creative.designer.chat.result.image.alt\": \"EVERA logo and Instagram poster designs\",\n  \"welcome.v2.agents.creative.designer.description\": \"Turn rough ideas into polished visual designs.\",\n  \"welcome.v2.agents.creative.designer.name\": \"Creative Designer\",\n  \"welcome.v2.agents.data.analysis.chat.greeting\": \"Hi! I'm Data Analysis Assistant. Share a Google Sheet, upload a spreadsheet or CSV, or just paste a table — then tell me what you want to understand. I'll check the numbers, look for trends and anomalies, and turn what I find into a clear answer or a report you can act on. I can also set it to run on a schedule.\",\n  \"welcome.v2.agents.data.analysis.chat.prompt\": \"Analyze my TikTok and Instagram data. What should I create next?\",\n  \"welcome.v2.agents.data.analysis.chat.response\": \"Your creator analytics report is ready. Discover your top audience, best content, revenue drivers, next steps, three content pillars, and a 30-day plan.\",\n  \"welcome.v2.agents.data.analysis.chat.result.image.alt\": \"Creator analytics report preview\",\n  \"welcome.v2.agents.data.analysis.description\": \"Analyze data to uncover trends and actionable insights.\",\n  \"welcome.v2.agents.data.analysis.name\": \"Data Analysis\",\n  \"welcome.v2.agents.description\": \"Each AI agent comes with expert knowledge and professional workflows built in, giving you a highly capable team for different kinds of work—without the setup.\",\n  \"welcome.v2.agents.h5.panel.alt\": \"Migoo AI agent list and Video Ad Producer conversation\",\n  \"welcome.v2.agents.job.apply.chat.attachment.resume.title\": \"Resume\",\n  \"welcome.v2.agents.job.apply.chat.greeting\": \"Hi! I'm Job Apply. Tell me where you're headed — a new job, a switch, a career change — and I'll find roles that fit, sharpen your resume and interviews, and help you apply. Give me a direction or a resume to start, or just tell me what you're looking for.\",\n  \"welcome.v2.agents.job.apply.chat.prompt\": \"I’m a content marketing specialist with 3 years of experience, and I want to move into an AI Content Strategist or AI Marketing Operations role in Singapore. Review my resume and recommend roles that fit.\",\n  \"welcome.v2.agents.job.apply.chat.response.heading\": \"Top role matches in Singapore:\",\n  \"welcome.v2.agents.job.apply.chat.response.recommendation\": \"Focus your resume on AI-powered workflows and content systems to align with these roles.\",\n  \"welcome.v2.agents.job.apply.chat.response.role.ai.content.executive.description\": \"hands-on AI role, but below your current seniority level\",\n  \"welcome.v2.agents.job.apply.chat.response.role.ai.content.executive.title\": \"AI Content Executive\",\n  \"welcome.v2.agents.job.apply.chat.response.role.engagement.content.strategy.manager.description\": \"best overall fit (seniority + AI focus)\",\n  \"welcome.v2.agents.job.apply.chat.response.role.engagement.content.strategy.manager.title\": \"Engagement & Content Strategy Manager (AI)\",\n  \"welcome.v2.agents.job.apply.chat.response.role.regional.content.specialist.description\": \"strong growth bridge into AI experimentation\",\n  \"welcome.v2.agents.job.apply.chat.response.role.regional.content.specialist.title\": \"Regional Content Specialist, SEO & AI Experimentation\",\n  \"welcome.v2.agents.job.apply.description\": \"Find matching roles and strengthen your applications.\",\n  \"welcome.v2.agents.job.apply.name\": \"Job Apply\",\n  \"welcome.v2.agents.list.label\": \"Agent\",\n  \"welcome.v2.agents.research.assistant.chat.artifact.meta\": \"PDF · 6.9MB · 26 pages\",\n  \"welcome.v2.agents.research.assistant.chat.artifact.title\": \"Research of Gen Z\",\n  \"welcome.v2.agents.research.assistant.chat.greeting\": \"Hi! I'm Research Assistant. What are we digging into? Give me a question, a market, a technology, or any topic — I can research it from multiple angles and deliver a structured report you can act on.\",\n  \"welcome.v2.agents.research.assistant.chat.prompt\": \"Research how Gen Z consumers in Indonesia, Thailand, and Vietnam discover and buy beauty products.\",\n  \"welcome.v2.agents.research.assistant.chat.response\": \"Your Gen Z Beauty & Personal-Care market brief is ready, with consumer insights and country-level recommendations.\",\n  \"welcome.v2.agents.research.assistant.chat.result.image.alt\": \"Gen Z beauty market research report preview\",\n  \"welcome.v2.agents.research.assistant.description\": \"Research any topic and deliver structured reports.\",\n  \"welcome.v2.agents.research.assistant.name\": \"Research Assistant\",\n  \"welcome.v2.agents.slide.assistant.chat.attachment.sales.performance.title\": \"H2 Sales Performance\",\n  \"welcome.v2.agents.slide.assistant.chat.attachment.strategic.growth.title\": \"Strategic Growth Plan\",\n  \"welcome.v2.agents.slide.assistant.chat.greeting\": \"Hi! I'm Slide Assistant. Got a topic, some notes, or raw data? Drop it here and I'll build you a clean deck — we'll nail down the outline first, then design every slide.\",\n  \"welcome.v2.agents.slide.assistant.chat.prompt\": \"Turn these notes and sales data into a strategic growth plan for EVERA, focused on market expansion.\",\n  \"welcome.v2.agents.slide.assistant.chat.response\": \"Your Strategic Growth Plan is ready, with clear priorities and an actionable expansion roadmap.\",\n  \"welcome.v2.agents.slide.assistant.chat.result.image.alt\": \"EVERA strategic growth plan slide deck\",\n  \"welcome.v2.agents.slide.assistant.description\": \"Build polished slide decks from notes, files, and data.\",\n  \"welcome.v2.agents.slide.assistant.name\": \"Slide Assistant\",\n  \"welcome.v2.agents.title.bottom\": \"Ready Out of the Box\",\n  \"welcome.v2.agents.title.top\": \"A Team of AI Experts,\",\n  \"welcome.v2.agents.video.ad.producer.chat.greeting\": \"Hi, I’m Video Ad Producer. Send me a product image, brand assets, product link, or a simple brief, then tell me the publishing or ad channel and your goal. I’ll turn it into a conversion-focused video ad up to 15 seconds long.\",\n  \"welcome.v2.agents.video.ad.producer.chat.prompt\": \"Using this store photo and my shop link, create a 15-second promotional video for my crystal shop.\",\n  \"welcome.v2.agents.video.ad.producer.chat.prompt.image.alt\": \"Crystal products displayed in a shop\",\n  \"welcome.v2.agents.video.ad.producer.chat.response\": \"I reviewed the 30 products in your store and selected the strongest visuals to feature. Here’s a warm, calming promotional video built around “Find Your Inner Light”.\",\n  \"welcome.v2.agents.video.ad.producer.chat.response.video.alt\": \"Promotional video preview for a crystal shop\",\n  \"welcome.v2.agents.video.ad.producer.description\": \"Turn product assets into conversion-focused video ads.\",\n  \"welcome.v2.agents.video.ad.producer.name\": \"Video Ad Producer\",\n  \"welcome.v2.agents.website.builder.chat.greeting\": \"Hi! I'm Website Builder. Share your content — a doc, some data, or even rough notes — and I'll turn it into a live web page you can open and share right away.\",\n  \"welcome.v2.agents.website.builder.chat.prompt\": \"Build a landing page for an AI interview coaching service with a waitlist form.\",\n  \"welcome.v2.agents.website.builder.chat.response\": \"Your launch page is ready with product messaging, social proof, and a clear CTA.\",\n  \"welcome.v2.agents.website.builder.chat.result.image.alt\": \"AI interview coaching landing page preview\",\n  \"welcome.v2.agents.website.builder.description\": \"Turn your content into a live, shareable web page.\",\n  \"welcome.v2.agents.website.builder.name\": \"Website Builder\",\n  \"welcome.v2.agents.writing.assistant.chat.draft.body.delay\": \"The launch will move by three business days following an issue identified in final QA. The issue is resolved, and the team is completing its final checks.\",\n  \"welcome.v2.agents.writing.assistant.chat.draft.body.next.step\": \"We’ll share the final assets by Thursday, with launch scheduled for Friday.\",\n  \"welcome.v2.agents.writing.assistant.chat.draft.closing\": \"Best,\",\n  \"welcome.v2.agents.writing.assistant.chat.draft.salutation\": \"Hi Maya,\",\n  \"welcome.v2.agents.writing.assistant.chat.draft.sender\": \"The EVERA Team\",\n  \"welcome.v2.agents.writing.assistant.chat.draft.subject\": \"Subject: Updated launch timeline and next steps\",\n  \"welcome.v2.agents.writing.assistant.chat.greeting\": \"Hi! I'm Writing Assistant. Share your content — a doc, some data, or even rough notes — and I'll turn it into a live web page you can open and share right away.\",\n  \"welcome.v2.agents.writing.assistant.chat.prompt\": \"Rewrite this client update to explain the delay, the fix, and the next step.\",\n  \"welcome.v2.agents.writing.assistant.chat.response\": \"Your client-ready update is clear, confident, and ready to send.\",\n  \"welcome.v2.agents.writing.assistant.description\": \"Draft polished content in your tone.\",\n  \"welcome.v2.agents.writing.assistant.name\": \"Writing Assistant\",\n  \"welcome.v2.connectors.description\": \"Migoo understands the information you choose to share, giving every agent the context to deliver more relevant work.\",\n  \"welcome.v2.connectors.title.bottom\": \"Knows How You Work.\",\n  \"welcome.v2.connectors.title.top\": \"Connected to Your Tools.\",\n  \"welcome.v2.work.data.analysis.description\": \"Migoo cleans and organizes scattered data, finds the trends that matter, and turns them into clear insights and next steps to improve your business.\",\n  \"welcome.v2.work.data.analysis.headline\": \"Turn messy data into clear decisions\",\n  \"welcome.v2.work.data.analysis.preview.alt\": \"Migoo data analysis dashboards and charts\",\n  \"welcome.v2.work.description\": \"Create business-ready videos, campaign visuals, polished slides and documents, in-depth research, and clear data analysis —all in one place.\",\n  \"welcome.v2.work.design.description\": \"Explore concepts, refine directions, and create campaign-ready visuals with an AI creative team working alongside you.\",\n  \"welcome.v2.work.design.headline\": \"Turn rough ideas into polished visuals\",\n  \"welcome.v2.work.design.preview.alt\": \"Migoo creative design workspace with posters and UI design previews\",\n  \"welcome.v2.work.design.title\": \"Creative Design\",\n  \"welcome.v2.work.research.description\": \"Migoo finds what matters, verifies key claims, and turns the research into concise, usable insights and reports.\",\n  \"welcome.v2.work.research.headline\": \"From scattered sources to clear answers\",\n  \"welcome.v2.work.research.preview.alt\": \"Migoo research dashboard with reports and topic cards\",\n  \"welcome.v2.work.slides.docs.description\": \"Transform notes, files, and data into clear decks & documents, —ready to edit, present, share, and act on.\",\n  \"welcome.v2.work.slides.docs.headline\": \"Turn messy inputs into polished, usable work\",\n  \"welcome.v2.work.slides.docs.preview.alt\": \"Migoo slides and documents template gallery\",\n  \"welcome.v2.work.tab.data.analysis\": \"Data Analysis\",\n  \"welcome.v2.work.tab.design\": \"Design\",\n  \"welcome.v2.work.tab.research\": \"Research\",\n  \"welcome.v2.work.tab.slides.docs\": \"Slides & Docs\",\n  \"welcome.v2.work.tab.video\": \"Video\",\n  \"welcome.v2.work.title.bottom\": \"Create, Research, Analyze and Deliver\",\n  \"welcome.v2.work.title.top\": \"Every Kind of Work\",\n  \"welcome.v2.work.video.description\": \"Turn one brief into polished video concepts, ready-to-test variations, and publishable assets—without the usual production drag.\",\n  \"welcome.v2.work.video.headline\": \"Create business-ready videos, from brief to publish\",\n  \"welcome.v2.work.video.preview.alt\": \"Migoo video template gallery with a generated ad preview\",\n  \"welcome.v2.work.video.title\": \"Video\"\n}\n","at":1792812104469},{"k":"fetch","m":"GET","u":"https://deo.shopeemobile.com/shopee/stm-sg-live/migoo-web/nonlive/en.col2030.json","b":null,"s":200,"ct":"application/json","t":"{\"add.friends.cancel\":\"Cancel\",\"add.friends.chat\":\"Chat\",\"add.friends.follow\":\"Follow\",\"add.friends.following\":\"Following\",\"add.friends.no.users\":\"No users found\",\"add.friends.people.you.may.know\":\"People you may know\",\"add.friends.search.placeholder\":\"Search username to add friends\",\"add.friends.search.results\":\"Search Results\",\"add.friends.title\":\"Add Friends\",\"auto_task.default_header_title\":\"Updated Saved Reminder\",\"bind_success.title_first\":\"Your Migoo is ready !\",\"bind_success.title_repe