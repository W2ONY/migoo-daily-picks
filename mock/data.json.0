ntro.try\":\"Try it Now\",\"chat.agent.add.bubble\":\"Click \\\"+\\\" to add more agents\",\"me.auto.task.conversation.not.found\":\"Conversation not found\",\"chat.agent.unselected.hint\":\"Select an agent or create a new one to get started\",\"pdp.invalid.removed\":\"Oops, this product has been removed\",\"pdp.toast.unavailable\":\"This product is temporarily unavailable for purchase\",\"connectors.custom.mcp.add\":\"Add Custom MCP\",\"connectors.custom.mcp.add.modal.add\":\"Add\",\"connectors.custom.mcp.add.modal.auth.oauth.clientid.label\":\"OAuth Client ID\",\"connectors.custom.mcp.add.modal.auth.oauth.clientid.placeholder\":\"Optional\",\"connectors.custom.mcp.add.modal.auth.oauth.clientsecret.label\":\"OAuth Client Secret\",\"connectors.custom.mcp.add.modal.auth.oauth.clientsecret.placeholder\":\"Optional\",\"connectors.custom.mcp.add.modal.auth.oauth.description\":\"We'll sign you in automatically. Only fill in the fields below if this service needs your own credentials.\",\"connectors.custom.mcp.add.modal.auth.oauth.title\":\"OAuth\",\"connectors.custom.mcp.add.modal.auth.public.description\":\"No extra authentication required. Just tap connect and you're in\",\"connectors.custom.mcp.add.modal.auth.public.title\":\"Public\",\"connectors.custom.mcp.add.modal.auth.title\":\"Authorize MCP\",\"connectors.custom.mcp.add.modal.auth.token.description\":\"Enter the access token from the service provider.\",\"connectors.custom.mcp.add.modal.auth.token.label\":\"Token\",\"connectors.custom.mcp.add.modal.auth.token.placeholder\":\"e.g. sk-a1b2c3d4...\",\"connectors.custom.mcp.add.modal.auth.token.title\":\"Access Token\",\"connectors.custom.mcp.add.modal.auth.type.title\":\"Authentication Type\",\"connectors.custom.mcp.add.modal.cancel\":\"Cancel\",\"connectors.custom.mcp.add.modal.name.invalid\":\"This name contains invalid characters.\",\"connectors.custom.mcp.add.modal.name.label\":\"Name\",\"connectors.custom.mcp.add.modal.name.placeholder\":\"Name your MCP\",\"connectors.custom.mcp.add.modal.subtitle\":\"Only use connectors from developers you trust.\",\"connectors.custom.mcp.add.modal.title\":\"Add Custom MCP\",\"connectors.custom.mcp.add.modal.url.invalid\":\"Please enter a valid URL\",\"connectors.custom.mcp.add.modal.url.label\":\"Server URL\",\"connectors.custom.mcp.add.modal.url.placeholder\":\"Remote MCP server URL, HTTP supported\",\"connectors.custom.mcp.detail.more\":\"More\",\"connectors.custom.mcp.detail.remove\":\"Remove\",\"connectors.custom.mcp.detail.tools.not.connected\":\"You are not connected to {mcp_name} yet\",\"connectors.custom.mcp.disconnect.already\":\"This MCP has already been disconnected.\",\"connectors.custom.mcp.empty\":\"No custom MCP yet\",\"connectors.custom.mcp.remove.confirm.desc\":\"Are you sure you want to remove {name}? You can add it again later.\",\"connectors.custom.mcp.remove.confirm.title\":\"Remove custom MCP?\",\"connectors.custom.mcp.remove.failed\":\"Failed to remove. Please try again\",\"connectors.custom.mcp.remove.success\":\"Removed successfully\",\"connectors.custom.mcp.tools.loading.failed\":\"Tools loading failed.\",\"connectors.tab.custom.mcp\":\"Custom MCP\",\"connectors.tab.featured\":\"Featured\",\"connectors.custom.mcp.error.limit.reached\":\"You've reached the limit for custom MCP connectors. Remove one to add a new one\",\"skills.hub.filter.added\":\"Added by me\",\"skills.hub.filter.all\":\"All\",\"skills.hub.filter.builtin\":\"Built-in\",\"skills.hub.filter.created\":\"Created by me\",\"media.creation.reference.upload.limit\":\"Only {max} photos can be uploaded.\",\"skills.detail.action.copy.to.edit\":\"Copy to Edit\",\"skills.detail.action.remix\":\"Remix with Migoo\",\"skills.detail.remix.prompt\":\"Remix the {skill} skill\",\"connectors.custom.mcp.connect.already\":\"This MCP has already been connected.\",\"common.cloudBrowser.kernel.remoteClipboardUnsupported\":\"Remote copy isn't synced to your local clipboard yet\",\"common.create\":\"Create\",\"skills.detail.action.edit.agent\":\"Edit with Agent\",\"skills.my.panel.builtin\":\"Built-in Skills\",\"delete_account.bullet_reregister\":\"After your account is deleted, you can sign up again with the same email address after 30 days\",\"welcome.card_1_alt\":\"Migoo proactive AI agent auto-manages email and calendar by processing unread emails, morning briefings, and urgent notifications.\",\"welcome.card_2_alt\":\"Migoo proactive AI agent auto-manages projects and meetings by preparing discussion points, progress reports, and presentation decks.\",\"welcome.card_3_alt\":\"Migoo proactive AI agent supports job hunting by improving LinkedIn profiles, optimizing CVs, and tracking job applications.\",\"welcome.hero_subtitle_mobile\":\"Most AI waits. Migoo moves. Give it a task and it works in the background — across email, calendar, meetings, and the job hunt. It does the groundwork; you make the call.\",\"welcome.hero_subtitle_web\":\"Most AI waits. Migoo moves. Give it an auto task and it works quietly in the background — across email, calendar, meetings, projects, and the job hunt — drafting your replies, prepping your meetings, writing your reports, sharpening your CV. It does the groundwork; you make the call. Proactive by design, approved by you.\",\"welcome.hero_title_v2\":\"Auto Your Tasks for Work and Life.\",\"welcome.use_case_title\":\"See How Migoo Works Ahead of You — Across Work and Life.\",\"welcome.usecase_1_alt\":\"Migoo morning briefing card summarizing weather, unread emails, urgent notifications, and meetings for the day.\",\"welcome.usecase_1_desc\":\"Migoo brings together your emails, follow-ups, and meetings that matter most today, all in one place.\",\"welcome.usecase_1_title\":\"Morning Briefing of Your Day\",\"welcome.usecase_2_alt\":\"Migoo inbox processing card showing 15 unread emails, drafted replies, urgent emails, and important client follow-ups.\",\"welcome.usecase_2_desc\":\"Migoo drafts replies, flags what's important, and summarizes the rest, the way you'd handle it yourself.\",\"welcome.usecase_2_title\":\"Process Unread & Urgent Email\",\"welcome.usecase_3_alt\":\"Migoo weekly report card showing project progress, revenue update, charts, and blockers that need attention.\",\"welcome.usecase_3_desc\":\"Migoo turns your work into a clear report of what's done, what's pending, blockers, and next steps.\",\"welcome.usecase_3_title\":\"Periodic Work Progress Update\",\"welcome.usecase_4_alt\":\"Migoo meeting brief card organizing company background, discussion points, and meeting angles from attachments.\",\"welcome.usecase_4_desc\":\"Migoo reviews your materials in advance and hands you the key points, context, and questions to raise, so you walk in ready.\",\"welcome.usecase_4_title\":\"Get Key Discussion Points from Meeting A