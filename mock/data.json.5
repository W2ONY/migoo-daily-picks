65176\",\"extinfo\":{\"tier_index\":[2,3]}},{\"offer_id\":\"walmart-20472814438\",\"extinfo\":{\"tier_index\":[0,1]}},{\"offer_id\":\"walmart-20464803208\",\"extinfo\":{\"tier_index\":[0,2]}},{\"offer_id\":\"walmart-20420001553\",\"extinfo\":{\"tier_index\":[1,3]}},{\"offer_id\":\"walmart-15322574968\",\"extinfo\":{\"tier_index\":[2,0]}}],\"cur_model_idx\":5},\"review_data\":{\"summary\":{\"total_count\":8149,\"summary_text\":\"Most customers left positive feedback, praising the product for its affordability, with many noting it cost around $15 for two applications. They also appreciate its effectiveness in preventing and treating fleas and ticks. However, some users reported it was ineffective, describing a situation where pets only scratched and bit for the next 15 to 20 days. Others mentioned a short duration, stating the product lasted only about two weeks before fleas began to reappear.\",\"rating_max\":4.3},\"featured_reviews\":[{\"comment_id\":330180138,\"user_name\":\"Marshall\",\"rating\":5,\"content\":\"Seems to work just like any other brand. No tick or fleas\",\"source\":\"brightdata\",\"create_time\":1791244800},{\"comment_id\":330180142,\"user_name\":\"jennifer\",\"rating\":5,\"content\":\"Took care of the fleas almost immediately\",\"source\":\"brightdata\",\"sort_order\":1,\"create_time\":1791072000},{\"comment_id\":330180136,\"user_name\":\"Abigail\",\"rating\":5,\"content\":\"This is a really good, inexpensive yet effective flea treatment for my small dogs.\\nBelieve me I've tried them all, and this works as well as that VERY expensive other brand. I live in the South so our flea issue is many months long.\",\"source\":\"brightdata\",\"sort_order\":2,\"create_time\":1791072000},{\"comment_id\":330180141,\"user_name\":\"gidget1988\",\"rating\":2,\"content\":\"Doesn't kill all the fleas\",\"source\":\"brightdata\",\"sort_order\":3,\"create_time\":1791072000},{\"comment_id\":330180140,\"user_name\":\"Steve\",\"rating\":5,\"content\":\"K9 Advatix works, one of the few I've tried that does!\",\"source\":\"brightdata\",\"sort_order\":4,\"create_time\":1791072000}]},\"item_details\":{\"product_spec\":[{\"name\":\"Brand Name\",\"value\":\"K9 Advantix\"},{\"name\":\"Unit Count\",\"value\":\"2 Count\"},{\"name\":\"Age Range Description\",\"value\":\"7 weeks and older\"},{\"name\":\"UPC\",\"value\":\"724089060556\"},{\"name\":\"Global Trade Identification Number\",\"value\":\"00724089060556\"},{\"name\":\"Item Type Name\",\"value\":\"Topical\"},{\"name\":\"Manufacturer\",\"value\":\"Elanco US Inc\"},{\"name\":\"Model Number\",\"value\":\"86314878\"},{\"name\":\"Manufacturer Part Number\",\"value\":\"86314878\"},{\"name\":\"Best Sellers Rank\",\"value\":\"#1,797 in Pet Supplies (See Top 100 in Pet Supplies)#13 in Dog Flea Drops\"},{\"name\":\"ASIN\",\"value\":\"B00I0BXQ6Q\"},{\"name\":\"Customer Reviews\",\"value\":\"4.34.3 out of 5 stars(19,459)4.3 out of 5 stars\"},{\"name\":\"Item Form\",\"value\":\"Drops\"},{\"name\":\"Scent Name\",\"value\":\"Unscented\"},{\"name\":\"Dog Breed Size\",\"value\":\"Small\"},{\"name\":\"Target Species\",\"value\":\"Dog\"},{\"name\":\"Item Weight\",\"value\":\"18.14 g\"},{\"name\":\"Volume\",\"value\":\"0.8 ml\"},{\"name\":\"Allergen Information\",\"value\":\"Allergen-Free\"},{\"name\":\"Active Ingredients\",\"value\":\"Imidacloprid, Permethrin, Pyriproxyfen\"},{\"name\":\"Product Dimensions\",\"value\":\"1 x 4.38 x 4.75 inches; 0.64 ounces\"},{\"name\":\"Item model number\",\"value\":\"86314878\"},{\"name\":\"Department\",\"value\":\"Flea \\u0026 Tick\"},{\"name\":\"Date First Available\",\"value\":\"June 8, 2012\"},{\"name\":\"Manufacturer\",\"value\":\"Elanco US Inc\"},{\"name\":\"ASIN\",\"value\":\"B00I0BXQ6Q\"},{\"name\":\"Customer Reviews\",\"value\":\"19459\"},{\"name\":\"Brand\",\"value\":\"K9 Advantix\"},{\"name\":\"Item Form\",\"value\":\"Drops\"},{\"name\":\"Scent\",\"value\":\"Unscented\"},{\"name\":\"Item Weight\",\"value\":\"18.14 g\"},{\"name\":\"Active Ingredients\",\"value\":\"Imidacloprid, Permethrin, Pyriproxyfen\"},{\"name\":\"Item Volume\",\"value\":\"0.8 ml\"},{\"name\":\"Allergen Information\",\"value\":\"Allergen-Free\"},{\"name\":\"Dog Breed Size\",\"value\":\"Small\"},{\"name\":\"Unit Count\",\"value\":\"2 Count\"},{\"name\":\"Color\",\"value\":\"Small Dog only\"}],\"rich_text\":[{\"type\":0,\"text\":\"Highlights\\nK9 Advantix II Small Dog kills and repels fleas, ticks, and mosquitoes.\\nKills existing fleas on contact within 12 hours to stop infestations.\\nFragrance-free, waterproof after 24 hours, and easy spot-on application.\\nProtects dogs 4-10 lbs (7+ weeks old) from fleas, ticks, mosquitoes, biting flies, and lice.\\nPrevents tapeworm transmission and flea allergy dermatitis.\\nAvailable over the counter in 2, 4, or 6-dose packs.\\n\\nDetails\\nOverview\\nThis veterinarian-recommended topical treatment defends against five pests: fleas, ticks, mosquitoes, biting flies, and lice. It is effective on both indoor and outdoor dogs and is a trademark of Elanco or its affiliates.\\nFunction \\u0026 Performance\\nThe formula stops existing flea infestations by killing adult fleas on contact so they cannot lay eggs. Monthly use is important to protect against fleas that may cause transmission of tapeworms, flea allergy dermatitis, and flea bite anemia.\\nUsage/Scenarios\\nYour dog should be at least 7 weeks old and weigh 4-10 lbs to use this product. Once applied, the dog is ready to get right back to cuddles and playing in the park.\\nCare Instructions\\nThe product is fragrance-free and becomes waterproof after 24 hours of application. Check the product label for information on application and potential side effects.\"}]},\"action_infos\":null,\"offer\":{\"id\":\"walmart-20472814438\",\"product_id\":120000532661679,\"cspu_id\":\"100000002770083\",\"url\":\"https://www.walmart.com/ip/2-pack-K9-Advantix-Flea-Tick-Mosquito-Prevention-for-Small-Dogs-4-10-lbs-2-Monthly-Treatments/20472814438\",\"availability\":\"in_stock\",\"price\":{\"single_value\":2996000,\"range_min\":0,\"range_max\":0,\"currency\":\"USD\"},\"supplier_name\":\"Walmart.com\",\"supplier_rating\":4.3,\"website\":\"walmart\",\"website_logo_url\":\"https://down-sg.img.susercontent.com/sg-11134327-824ij-mput674daadqbc\",\"video_urls\":[\"https://www.amazon.com/vdp/00c6465402b34ef6bae7f91ea00092fc\"],\"review_data\":{\"featured_reviews\":[{\"user_name\":\"anonymous\",\"rating\":5,\"content\":\"These are the lowest priced flea %26 tick liquid that works great. You don't have to get those other expensive ones, especially if they're inside dogs, but one of my dogs is an outside dogn%26 it works just fine. Its a 2 month pack, but still a lot lower price than others %26 they're a brand that is known.\"},{\"user_name\":\"Brenda\",\"rating\":1,\"content\":\"Won't work to kill fleas. Useless\",\"sort_order\":1},{\"user_name\":\"Callie\",\"rating\":1,\"content\":\"Do not waste your money on this!!! I bought two for my two dogs, a Yorkie and dachshund. I put it in them exactly as directed and they are covered!!! I even have bites on me! 😡 I understand fleas are hard to control but this stuff is garbage!\",\"sort_order\":2},{\"user_name\":\"Marissa\",\"rating\":5,\"content\":\"This flea and tick medication is the only kind I use on my dogs . My German Shepherd has sensitive skin, and this is the only brand that does not break her skin out and actually gets rid of fleas ticks and protects against mosquitoes.\\n\\nEvery time I see this box, I always sing the k9 advantix song in my head or directly to my dogs(if anyone remembers the commercial from years ago)\",\"sort_order\":3},{\"user_name\":\"anonymous\",\"rating\":5,\"content\":\"I've been using this for a few years now and it hasn't let me down yet. My German Shepard is no longer scratching or chewing from fleas. And it usually lasts two to three months, even though it says monthly dosage. Highly recommended.\",\"sort_order\":4}]}},\"rcmd_reason_tag\":[\"Protective\",\"Fast Acting\"