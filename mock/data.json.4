"price\":{\"single_value\":14900000,\"range_min\":0,\"range_max\":0,\"currency\":\"usd\"}},\"variation_infos\":{\"tier_variations\":[{\"name\":\"Color\",\"options\":[\"Navy / Sahara\"],\"display_indicators\":[0]}]},\"model_infos\":{\"models\":[{\"offer_id\":\"Topo Designs-8217256820789-45904929357877\",\"extinfo\":{\"tier_index\":[0]}}],\"cur_model_idx\":0},\"review_data\":{\"summary\":{\"total_count\":586,\"summary_text\":\"90% of customers left positive feedback. Shoppers particularly appreciate the spacious interior, noting it comfortably fits two laptops, chargers, lunch, a change of clothes, and various essentials. They also praise the durability, describing the material as very durable. A smaller number of reviewers mentioned missing features, such as a dedicated drink pocket for a travel mug and the ability to fully remove the backpack straps.\",\"rating_max\":4.744027},\"featured_reviews\":[{\"comment_id\":335651306,\"user_name\":\"Daniel F.\",\"rating\":5,\"content\":\"Everything feels well-thought-out in this bag. It's solidly made and has just enough compartments to keep things organized without being too restricting and complicated. My only gripe is that the fabric loops that you attach the shoulder straps to are really small, which makes attaching and removing the shoulder strap kind of finicky and cumbersome. I don't need to do that too often so it's still 5 stars for me, but something to keep in mind if you see yourself converting from shoulder bag to backpack/suitcase frequently.\",\"source\":\"crawler\",\"create_time\":1792100445},{\"comment_id\":333258065,\"user_name\":\"Matt K.\",\"rating\":5,\"content\":\"I traveled through Four Countries and Eight Flights, 14 Hotels stays over 19 days. BAG PERFORMED Awesome!! Three different Airlines, two of them EU Commuters. Bag fit no problem in under seat storage on all airlines. I really liked the big compartment zippers, two front pockets are handy and I stowed my Sony Noise Cancelling headphones in one of the front pockets, NO PROBLEM. I also appreciate the slot pocket inside for quick access to passport, Wallet and ID. Especially when traveling through Europe, I think I showed my passport no less than a dozen times. Another big win for Topo Design with the (truly) Global Briefcase!!\",\"source\":\"crawler\",\"sort_order\":1,\"create_time\":1790791903},{\"comment_id\":333258067,\"user_name\":\"Noel C.\",\"rating\":5,\"content\":\"Love the quality of the bag. Fits really well and it's a perfect size.\",\"source\":\"crawler\",\"sort_order\":2,\"create_time\":1790742414},{\"comment_id\":333258064,\"user_name\":\"James M.\",\"rating\":5,\"content\":\"One of my favorite Topo purchases to date. Extremely versatile, storage compartments are well thought of and love the colors for this product.\",\"source\":\"crawler\",\"sort_order\":3,\"create_time\":1789499723},{\"comment_id\":333258062,\"user_name\":\"Craig P.\",\"rating\":5,\"content\":\"I have this bag, and love it. It is only missing one thing, a side pocket for a water bottle!! Otherwise, great bag\",\"source\":\"crawler\",\"sort_order\":4,\"create_time\":1789450708}]},\"item_details\":{\"product_spec\":[{\"name\":\"Style Name\",\"value\":\"Global Briefcase\"},{\"name\":\"Handbag Silhouette\",\"value\":\"Briefcase\"},{\"name\":\"Pattern\",\"value\":\"Solid\"},{\"name\":\"Seasons\",\"value\":\"All\"},{\"name\":\"Item Shape\",\"value\":\"Rectangular\"},{\"name\":\"Pattern\",\"value\":\"Solid\"},{\"name\":\"Closure Type\",\"value\":\"Zipper\"},{\"name\":\"Strap Type\",\"value\":\"Shoulder\"},{\"name\":\"Pocket Description\",\"value\":\"Stash Pocket\"},{\"name\":\"Handle Type\",\"value\":\"shoulder strap\"},{\"name\":\"Number of Compartments\",\"value\":\"4\"},{\"name\":\"Number Of Pockets\",\"value\":\"2\"},{\"name\":\"Number of Handles\",\"value\":\"2\"},{\"name\":\"Number of Sections\",\"value\":\"4\"},{\"name\":\"Fit to Size Sentiment\",\"value\":\"Neutral/Positive\"},{\"name\":\"Shoulder to Bottom Hem Length\",\"val